# ========================================================
# SmartDrive AI — Backend Environment Configuration
# ========================================================

# Server Port
PORT=3000

# Client Application URL (For CORS & Socket.IO Origin)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/car-rental?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/car-rental?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=smartdrive_ai_jwt_super_secret_key_2026_change_in_production

# Google Gemini API Key (SmartDrive AI Assistant)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ImageKit Storage & CDN Optimization Credentials
# Sign up free at: https://imagekit.io
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Razorpay Payment Gateway (Test Mode)
# Sign up at: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey

# Nodemailer Email Service (SMTP Configuration)
# For Gmail: Use App Password from Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@smartdriveai.com
